{
  "compilerOptions": {
    "module": "Node16",
    "target": "ESNext",
    "lib": ["ESNext"],
    "strict": true,
    "composite": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  },
  "include": ["src"]
}
